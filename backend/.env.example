# Copie este arquivo para `.env` e ajuste os valores.
# Nenhuma dessas variáveis tem um valor secreto real aqui -- os defaults no
# código (core/settings.py) só existem para não travar o `runserver` local.

# Segurança
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados -- em produção, defina DATABASE_URL (ex.: postgres://user:senha@host:5432/nome)
# Sem DATABASE_URL, o settings.py tenta montar a URL a partir das variáveis POSTGRES_* abaixo.
DATABASE_URL=
POSTGRES_DB=buildpoint
POSTGRES_USER=buildpoint
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_SSL_REQUIRE=False

# CORS -- domínios do app/painel autorizados a chamar a API (separados por vírgula)
CORS_ALLOWED_ORIGINS=

# Biometria facial
# Limiar de similaridade de cosseno para aceitar uma identidade (calibrado para o
# modelo MobileFaceNet em uso -- não é um valor universal, recalibre se trocar de modelo).
FACE_LIMIAR_CONFIANCA=0.875
# Identifica qual modelo gerou os embeddings salvos (permite trocar de modelo no futuro
# sem confundir embeddings antigos com o novo algoritmo).
FACE_ALGORITMO_PADRAO=mobilefacenet-tflite-v1
# Chave Fernet (32 bytes urlsafe-base64) usada para cifrar o embedding facial em repouso.
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA reutilize o valor de exemplo do settings.py em produção.
BIOMETRIA_ENCRYPTION_KEY=

# Assinatura digital (BirdID / ICP-Brasil) -- ainda não integrado no código,
# variáveis reservadas para quando o recibo em PDF passar a ser assinado (PAdES).
BIRDID_API_URL=
BIRDID_API_TOKEN=
